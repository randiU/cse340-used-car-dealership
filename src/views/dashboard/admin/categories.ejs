<%- include("../../partials/header") %>
<main>
    <div class="site-container">
    <h1 class="page-title"><%= title %></h1>
    <p>Manage vehicle categories below.</p>

    <p><a href="/admin/categories/new">Add New Category</a></p>

    <% if (categories && categories.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% categories.forEach(category => { %>
                    <tr>
                        <td><%= category.name %></td>
                        <td><%= category.slug %></td>
                        <td><%= category.description %></td>
                        <td>
                            <a href="/admin/categories/<%= category.category_id %>/edit">Edit</a>

                            <form action="/admin/categories/<%= category.category_id %>/delete" method="post" style="display:inline;">
                                <button type="submit" onclick="return confirm('Delete this category?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <p>No categories found.</p>
    <% } %>

    <p><a href="/admin">Back to Admin Dashboard</a></p>
    </div>
</main>

<%- include("../../partials/footer") %>
