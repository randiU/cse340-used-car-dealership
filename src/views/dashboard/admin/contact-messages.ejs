<%- include("../../partials/header") %>
<main>
    <div class="site-container">
    <h1 class="page-title"><%= title %></h1>
    <% if (messages && messages.length > 0) { %>
    <section class="contact-messages-list">
        <% messages.forEach(message => { %>
        <article class="contact-message-card">
            <h2><%= message.subject %></h2>

            <p><strong>From:</strong> <%= message.name %></p>
            <p><strong>Email:</strong> <%= message.email %></p>
            <p><strong>Received:</strong> <%= new Date(message.created_at).toLocaleString() %></p>

            <div class="contact-message-body">
                <p><%= message.message %></p>
            </div>

            <form action="/admin/contact-messages/<%= message.message_id %>/delete" method="post">
                <button type="submit">Delete Message</button>
            </form>
        </article>
        <hr>
        <% }) %>
    </section>
    <% } else { %>
    <p>No contact messages found.</p>
    <% } %>
    </div>
</main>

<%- include("../../partials/footer") %>