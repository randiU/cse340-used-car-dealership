<%- include("../../partials/dashboard-header") %>

<main>
    <div class="site-container">
        <h1 class="page-title page-title-accent"><%= title %></h1>

        <section class="dashboard-section-card">
            <h2 class="section-title">Service Requests</h2>

            <% if (requests && requests.length > 0) { %>
            <div class="dashboard-card-grid">
                <% requests.forEach(request => { %>
                <article class="dashboard-item-card">
                    <h3><%= request.year %> <%= request.make %> <%= request.model %></h3>

                    <p><strong>Customer:</strong> <%= request.first_name %> <%= request.last_name %></p>
                    <p><strong>Email:</strong> <%= request.email %></p>
                    <p><strong>Service Type:</strong> <%= request.service_type %></p>
                    <p><strong>Status:</strong> <%= request.status %></p>
                    <p><strong>Submitted:</strong> <%= new Date(request.created_at).toLocaleString() %></p>
                    <p><%= request.description %></p>
<%# AI helped with logic for updating service request status %>
                    <div class="dashboard-form-wrap">
                        <div class="dashboard-form-card form-card">
                            <form action="/employee/service-requests/<%= request.request_id %>/status" method="post">
                                <div>
                                    <label for="status-<%= request.request_id %>">Update Status</label>
                                    <select id="status-<%= request.request_id %>" name="status" required>
                                        <option value="submitted"
                                            <%= request.status === "submitted" ? "selected" : "" %>>Submitted</option>
                                        <option value="in_progress"
                                            <%= request.status === "in_progress" ? "selected" : "" %>>In Progress
                                        </option>
                                        <option value="completed"
                                            <%= request.status === "completed" ? "selected" : "" %>>Completed</option>
                                    </select>
                                </div>

                                <button type="submit">Update Status</button>
                            </form>
                        </div>
                    </div>

                    <div class="dashboard-form-wrap">
                        <div class="dashboard-form-card form-card">
                            <form action="/employee/service-requests/<%= request.request_id %>/notes" method="post">
                                <div>
                                    <label for="notes-<%= request.request_id %>">Add/Edit Notes</label>
                                    <textarea id="notes-<%= request.request_id %>" name="notes" rows="4"
                                        placeholder="Enter notes here..." required><%= request.notes || "" %></textarea>
                                </div>

                                <button type="submit">Save Notes</button>
                            </form>
                        </div>
                    </div>
                </article>
                <% }) %>
            </div>
            <% } else { %>
            <div class="dashboard-empty-state">
                <p>No service requests found.</p>
            </div>
            <% } %>
        </section>
<!-- AI assisted with logic -->
        <p>
            <a href="<%= user?.roleName?.toLowerCase() === 'admin' ? '/admin' : user?.roleName?.toLowerCase() === 'employee' ? '/employee' : '/dashboard' %>">
                Back to Dashboard
            </a>
        </p>
    </div>
</main>

<%- include("../../partials/footer") %>