<%- include("../partials/dashboard-header") %>

<main>
    <div class="site-container">
        <h1 class="page-title page-title-accent"><%= title %></h1>

        <section class="dashboard-section-card">
            <h2 class="section-title">Welcome</h2>
            <p>Hello, <%= user ? user.firstName : "User" %>.</p>
            <p>Your role: <%= user ? user.roleName : "" %></p>
        </section>

        <section class="dashboard-section-card">
            <h2 class="section-title">My Vehicles</h2>

            <% if (vehicles && vehicles.length > 0) { %>
            <div class="dashboard-card-grid">
                <% vehicles.forEach(vehicle => { %>
                <article class="dashboard-item-card">
                    <h3><%= vehicle.year %> <%= vehicle.make %> <%= vehicle.model %></h3>
                    <p><strong>Mileage:</strong> <%= Number(vehicle.mileage || 0).toLocaleString() %></p>
                    <p><strong>Added:</strong> <%= new Date(vehicle.created_at).toLocaleDateString() %></p>

                    <div class="action-group">
                        <a href="/my-vehicles/<%= vehicle.user_vehicle_id %>/edit" class="button">Edit Vehicle</a>

                        <form action="/my-vehicles/<%= vehicle.user_vehicle_id %>/delete" method="post">
                            <button type="submit">Delete Vehicle</button>
                        </form>
                    </div>
                </article>
                <% }) %>
            </div>
            <% } else { %>
            <div class="dashboard-empty-state">
                <p>You have not added any vehicles yet.</p>
            </div>
            <% } %>
        </section>

        <section class="dashboard-section-card">
            <h2 class="section-title">My Reviews</h2>

            <% if (reviews && reviews.length > 0) { %>
            <div class="dashboard-card-grid">
                <% reviews.forEach(review => { %>
                <article class="dashboard-item-card">
                    <h3>
                        <a href="/vehicles/<%= review.slug %>">
                            <%= review.year %> <%= review.make %> <%= review.model %>
                        </a>
                    </h3>

                    <p><strong>Rating:</strong> <%= review.rating %>/5</p>
                    <p><%= review.review_text %></p>
                    <p><strong>Posted:</strong> <%= new Date(review.created_at).toLocaleDateString() %></p>

                    <div class="action-group">
                        <a href="/vehicles/<%= review.slug %>" class="button">Manage Review</a>
                    </div>
                </article>
                <% }) %>
            </div>
            <% } else { %>
            <div class="dashboard-empty-state">
                <p>You have not submitted any reviews yet.</p>
            </div>
            <% } %>
        </section>

        <section class="dashboard-section-card">
            <h2 class="section-title">Add a Vehicle</h2>

            <div class="dashboard-form-card form-card">
                <form action="/my-vehicles/add" method="post">
                    <div>
                        <label for="make">Make</label>
                        <select id="make" name="make" required>
                            <option value="">Select a make</option>
                            <option value="Toyota">Toyota</option>
                            <option value="Honda">Honda</option>
                            <option value="Ford">Ford</option>
                            <option value="Chevrolet">Chevrolet</option>
                            <option value="Nissan">Nissan</option>
                            <option value="Hyundai">Hyundai</option>
                            <option value="Kia">Kia</option>
                            <option value="Subaru">Subaru</option>
                            <option value="Mazda">Mazda</option>
                            <option value="Jeep">Jeep</option>
                            <option value="GMC">GMC</option>
                            <option value="Ram">Ram</option>
                            <option value="Volkswagen">Volkswagen</option>
                            <option value="BMW">BMW</option>
                            <option value="Mercedes-Benz">Mercedes-Benz</option>
                            <option value="Audi">Audi</option>
                            <option value="Tesla">Tesla</option>
                        </select>
                    </div>

                    <div>
                        <label for="model">Model</label>
                        <input type="text" id="model" name="model" required>
                    </div>

                    <div>
                        <label for="year">Year</label>
                        <input type="number" id="year" name="year" required>
                    </div>

                    <div>
                        <label for="mileage">Mileage</label>
                        <input type="number" id="mileage" name="mileage">
                    </div>

                    <button type="submit">Add Vehicle</button>
                </form>
            </div>
        </section>

        <section class="dashboard-section-card">
            <h2 class="section-title">Service Requests</h2>
            <div class="dashboard-actions">
                <a href="/service/request" class="button">Submit Service Request</a>
                <a href="/service/history" class="button">View Service History</a>
            </div>
        </section>
    </div>
</main>

<%- include("../partials/footer") %>