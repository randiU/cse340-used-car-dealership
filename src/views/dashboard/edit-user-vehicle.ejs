<%- include("../partials/dashboard-header") %>
<main>
    <div class="site-container">
        <section class="form-page">
            <h1 class="page-title page-title-accent"><%= title %></h1>

            <div class="form-card">
                <form action="/my-vehicles/<%= vehicle.user_vehicle_id %>/edit" method="post">
                    <div>
                        <label for="make">Make</label>
                        <select id="make" name="make" required>
                            <option value="">Select a make</option>
                            <option value="Toyota" <%= vehicle.make === "Toyota" ? "selected" : "" %>>Toyota</option>
                            <option value="Honda" <%= vehicle.make === "Honda" ? "selected" : "" %>>Honda</option>
                            <option value="Ford" <%= vehicle.make === "Ford" ? "selected" : "" %>>Ford</option>
                            <option value="Chevrolet" <%= vehicle.make === "Chevrolet" ? "selected" : "" %>>Chevrolet
                            </option>
                            <option value="Nissan" <%= vehicle.make === "Nissan" ? "selected" : "" %>>Nissan</option>
                            <option value="Hyundai" <%= vehicle.make === "Hyundai" ? "selected" : "" %>>Hyundai</option>
                            <option value="Kia" <%= vehicle.make === "Kia" ? "selected" : "" %>>Kia</option>
                            <option value="Subaru" <%= vehicle.make === "Subaru" ? "selected" : "" %>>Subaru</option>
                            <option value="Mazda" <%= vehicle.make === "Mazda" ? "selected" : "" %>>Mazda</option>
                            <option value="Jeep" <%= vehicle.make === "Jeep" ? "selected" : "" %>>Jeep</option>
                            <option value="GMC" <%= vehicle.make === "GMC" ? "selected" : "" %>>GMC</option>
                            <option value="Ram" <%= vehicle.make === "Ram" ? "selected" : "" %>>Ram</option>
                            <option value="Volkswagen" <%= vehicle.make === "Volkswagen" ? "selected" : "" %>>Volkswagen
                            </option>
                            <option value="BMW" <%= vehicle.make === "BMW" ? "selected" : "" %>>BMW</option>
                            <option value="Mercedes-Benz" <%= vehicle.make === "Mercedes-Benz" ? "selected" : "" %>>
                                Mercedes-Benz
                            </option>
                            <option value="Audi" <%= vehicle.make === "Audi" ? "selected" : "" %>>Audi</option>
                            <option value="Tesla" <%= vehicle.make === "Tesla" ? "selected" : "" %>>Tesla</option>
                        </select>
                    </div>

                    <div>
                        <label for="model">Model</label>
                        <input type="text" id="model" name="model" value="<%= vehicle.model %>" required>
                    </div>

                    <div>
                        <label for="year">Year</label>
                        <input type="number" id="year" name="year" value="<%= vehicle.year %>" required>
                    </div>

                    <div>
                        <label for="mileage">Mileage</label>
                        <input type="number" id="mileage" name="mileage" value="<%= vehicle.mileage %>" required>
                    </div>

                    <button type="submit">Update Vehicle</button>
                </form>
            </div>
        </section>

        <p><a href="/dashboard">Back to Dashboard</a></p>
    </div>
</main>

<%- include("../partials/footer") %>