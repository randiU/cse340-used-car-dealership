<%- include("../partials/dashboard-header") %>

<main>
    <div class="site-container">
        <h1 class="page-title page-title-accent"><%= title %></h1>

        <section class="dashboard-section-card">
            <h2 class="section-title">Employee Access</h2>
            <p>Use this page to manage employee access and account roles.</p>

            <% if (users && users.length > 0) { %>
            <div class="dashboard-table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Current Role</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(account => { %>
                        <tr>
                            <td><%= account.first_name %> <%= account.last_name %></td>
                            <td><%= account.email %></td>
                            <td><%= account.role_name %></td>
                            <td>
                                <% if (account.role_name === "admin") { %>
                                <span>Admin account</span>
                                <% } else { %>
                                <form action="/admin/employees/<%= account.user_id %>/role" method="post"
                                    class="dashboard-inline-form">
                                    <label for="role_name_<%= account.user_id %>" class="sr-only">Role</label>
                                    <select name="role_name" id="role_name_<%= account.user_id %>">
                                        <option value="user" <%= account.role_name === "user" ? "selected" : "" %>>User
                                        </option>
                                        <option value="employee"
                                            <%= account.role_name === "employee" ? "selected" : "" %>>
                                            Employee
                                        </option>
                                    </select>
                                    <button type="submit">Update Role</button>
                                </form>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="dashboard-empty-state">
                <p>No users found.</p>
            </div>
            <% } %>

            <div class="dashboard-actions">
                <a href="/admin" class="button">Back to Admin Dashboard</a>
            </div>
        </section>
    </div>
</main>

<%- include("../partials/footer") %>