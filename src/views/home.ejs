<%- include("partials/header") %>

<main class="home-main">
    <div class="site-container">
        <section class="hero-banner">
            <img src="/images/home-banner-2.jpg" alt="Wasatch Auto Group Banner" class="home-banner">

            <aside class="hero-testimonial">
                <p class="hero-testimonial-label">Customer Testimonial</p>
                <blockquote>
                    “Wasatch Auto made the whole process easy. We found the perfect SUV, got honest answers, and drove
                    away feeling confident in our purchase.”
                </blockquote>
                <p class="hero-testimonial-author">— The Martinez Family</p>
            </aside>
        </section>

        <section class="home-intro-card">
            <h1 class="home-title">Welcome to Wasatch Auto</h1>
            <p>
                Welcome to Wasatch Auto — where finding the right vehicle is simple, honest, and stress-free. We’re
                proud to offer quality used cars, fair pricing, and friendly service you can trust. Whether you’re
                buying your first car or upgrading for your family, we’re here to help you drive away with confidence.
            </p>
        </section>


        <section class="featured-section home-section-card">
            <h2 class="section-title">Featured Vehicles</h2>
            <p>
                Check out some of our top picks from our inventory. These vehicles are popular among our customers and
                offer
                great value for their price.
            </p>

            <% if (featuredVehicles && featuredVehicles.length > 0) { %>
            <div class="home-vehicle-grid">
                <% featuredVehicles.forEach(vehicle => { %>
                <article class="home-vehicle-card">
                    <a href="/vehicles/<%= vehicle.slug %>">
                        <img src="<%= vehicle.image_path || '/images/vehicles/placeholder.jpg' %>"
                            alt="<%= vehicle.alt_text || `${vehicle.year} ${vehicle.make} ${vehicle.model}` %>"
                            onerror="this.onerror=null;this.src='/images/vehicles/placeholder.jpg';">
                    </a>

                    <h3>
                        <a href="/vehicles/<%= vehicle.slug %>">
                            <%= vehicle.year %> <%= vehicle.make %> <%= vehicle.model %>
                        </a>
                    </h3>

                    <div class="home-vehicle-meta">
                        <p><strong>Category:</strong> <%= vehicle.category_name || "Uncategorized" %></p>
                        <p><strong>Price:</strong> $<%= Number(vehicle.price).toLocaleString() %></p>
                        <p><strong>Mileage:</strong> <%= Number(vehicle.mileage).toLocaleString() %> miles</p>
                    </div>

                    <a href="/vehicles/<%= vehicle.slug %>" class="home-card-link">View Details</a>
                </article>
                <% }) %>
            </div>
            <% } else { %>
            <p>No featured vehicles available at this time.</p>
            <% } %>
        </section>

        <section class="home-section-card">
            <h2 class="section-title">Browse Our Inventory</h2>
            <p>
                Explore our wide selection of pre-owned vehicles, from reliable sedans to rugged SUVs. Each car is
                thoroughly
                inspected and priced competitively to ensure you get the best value.
            </p>

            <nav class="category-filters">
                <a href="/vehicles" class="category-chip">
                    <span class="category-chip-icon">
                        <img src="/images/icons/categories-green.svg" alt="" aria-hidden="true">
                        <img src="/images/icons/categories-white.svg" alt="" aria-hidden="true">
                    </span>
                    <span>All Vehicles</span>
                </a>

                <% if (categories && categories.length > 0) { %>
                <% categories.forEach(category => { %>
                <%
                let iconName = "categories-green.svg";
                let iconHoverName = "categories-white.svg";

                if (category.slug === "car") {
                    iconName = "car-green.svg";
                    iconHoverName = "car-white.svg";
                } else if (category.slug === "suv") {
                    iconName = "suv-green.svg";
                    iconHoverName = "suv-white.svg";
                } else if (category.slug === "truck") {
                    iconName = "truck-green.svg";
                    iconHoverName = "truck-white.svg";
                } else if (category.slug === "van") {
                    iconName = "van-green.svg";
                    iconHoverName = "van-white.svg";
                }
            %>

                <a href="/vehicles/category/<%= category.slug %>" class="category-chip">
                    <span class="category-chip-icon">
                        <img src="/images/icons/<%= iconName %>" alt="" aria-hidden="true">
                        <img src="/images/icons/<%= iconHoverName %>" alt="" aria-hidden="true">
                    </span>
                    <span><%= category.name %></span>
                </a>
                <% }) %>
                <% } %>
            </nav>

        </section>

        <section class="home-section-card">
            <h2 class="section-title">Contact Us</h2>
            <p>
                Have questions or want to schedule a test drive? Our team is here to help.
            </p>
            <a href="/contact" class="button">Contact Us</a>
        </section>
    </div>
</main>

<%- include("partials/footer") %>